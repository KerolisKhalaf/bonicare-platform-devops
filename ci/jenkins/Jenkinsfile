pipeline {

    agent any

    options {
        timestamps()
        ansiColor('xterm')
        disableConcurrentBuilds()

        buildDiscarder(logRotator(
            numToKeepStr: '20',
            artifactNumToKeepStr: '10'
        ))
    }

    environment {

        DOCKER_BUILDKIT = "1"
        COMPOSE_DOCKER_CLI_BUILD = "1"

        REGISTRY = "docker.io"
        NAMESPACE = "keroliskhalaf1"

        // Branch currently being tested
        BRANCH_NAME = "feature/jenkins-pipeline"
    }

    stages {

        stage('Checkout Repository') {
            steps {

                cleanWs()

                checkout scm

                script {

                    env.GIT_SHA = sh(
                        script: 'git rev-parse --short=12 HEAD',
                        returnStdout: true
                    ).trim()

                    env.IMAGE_TAG = env.GIT_SHA
                }

                echo "Building Branch: ${env.BRANCH_NAME ?: 'detached'}"
                echo "Commit: ${env.GIT_SHA}"
                echo "Image Tag: ${env.IMAGE_TAG}"
                echo "========================================"
            }
        }

        stage('Docker Information') {
            steps {

                sh '''
                    set -e

                    echo "Docker version:"
                    docker version

                    echo "Docker Buildx version:"
                    docker buildx version

                    echo "Docker info:"
                    docker info
                '''
            }
        }

        stage('Create Buildx Builder') {
            steps {

                sh '''
                    docker buildx inspect bonicare-builder >/dev/null 2>&1 || \
                    docker buildx create \
                        --name bonicare-builder \
                        --driver docker-container

                    docker buildx use bonicare-builder

                    docker buildx inspect --bootstrap
                '''
            }
        }

        stage('Validate Docker Configuration') {
            steps {

                withCredentials([
                    file(
                        credentialsId: 'bonicare-env',
                        variable: 'ENV_FILE'
                    )
                ]) {

                    sh '''
                        set -eu

                        echo "========================================"
                        echo "Validating Docker configuration"
                        echo "========================================"

                        # Provide .env where compose/compose.yaml expects it
                        cp "$ENV_FILE" "$WORKSPACE/.env"

                        # Always remove the temporary .env after validation
                        trap 'rm -f "$WORKSPACE/.env"' EXIT

                        echo "Validating Docker Bake configuration..."

                        docker buildx bake \
                            --print \
                            --file ci/docker-bake.hcl \
                            >/dev/null

                        echo "Validating Docker Compose configuration..."

                        docker compose \
                            -f compose/compose.yaml \
                            config -q

                        echo "Docker configuration validation passed."
                    '''
                }
            }
        }

        stage('Test Backend') {
            steps {

                dir('apps/bonicare-backend') {
                    sh '''
                        npm ci
                        npm test
                    '''
                }
            }
        }

        stage('Docker Login') {
            steps {

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub_id',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )
                ]) {

                    sh '''
                        set -e

                        echo "$DOCKER_PASS" | docker login \
                            --username "$DOCKER_USER" \
                            --password-stdin
                    '''
                }
            }
        }

        stage('Build & Push Images') {
            steps {

                withEnv([
                    "VERSION=${IMAGE_TAG}",
                    "REGISTRY=${REGISTRY}",
                    "NAMESPACE=${NAMESPACE}"
                ]) {

                    sh '''
                        set -e

                        echo "========================================"
                        echo "Building and pushing Docker images"
                        echo "Registry : ${REGISTRY}"
                        echo "Namespace: ${NAMESPACE}"
                        echo "Version  : ${VERSION}"
                        echo "========================================"

                        docker buildx bake \
                            --push \
                            --file ci/docker-bake.hcl
                    '''
                }
            }
        }
    }

    post {

        success {
            echo "========================================"
            echo "CI Pipeline Finished Successfully"
            echo "Branch: ${BRANCH_NAME}"
            echo "Images pushed with tag: ${IMAGE_TAG}"
            echo "========================================"
        }

        failure {
            echo "========================================"
            echo "CI Pipeline Failed"
            echo "Branch: ${BRANCH_NAME}"
            echo "========================================"
        }

        always {

            sh 'docker logout || true'

            cleanWs()
        }
    }
}